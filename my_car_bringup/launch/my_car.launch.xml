<launch>
    <!--when load a mesh, set GZ_SIM_RESOURCE_PATH to the folder containing the mesh-->
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share my_car_description)/.." />
    
    <let name="car_urdf_path" value="$(find-pkg-share my_car_description)/urdf/car.xacro" />
    <let name="rviz_path" value="$(find-pkg-share my_car_description)/rviz/rviz_config.rviz" />

    <let name="bridge_path" value="$(find-pkg-share my_car_bringup)/config/ros_gz_bridge.yaml" />
    <let name="world_path" value="$(find-pkg-share my_car_bringup)/worlds/my_world.sdf" />
    <let name="nav2_config_path" value="$(find-pkg-share my_car_bringup)/config/nav2_params.yaml" />
    <let name="slam_toolbox_config_path" value="$(find-pkg-share my_car_bringup)/config/slam_config.yaml" />
    
    <!--robot state publisher node-->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var car_urdf_path)')" />
        <param name="use_sim_time" value="true" />
    </node>

    <!--initiate a world-->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-s -r $(var world_path)" /> 
    </include>

    <!--spawn robot in the world-->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />

    <!--wait for spawn to finish, then initialize Gazebo GUI.
        otherwise, lidar visualization in Gazebo GUI won't track robot's pose-->
    <timer period="10">
        <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name="gz_args" value="-g" /> 
        </include>
    </timer>
    
    <!--joint state publisher node-->
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var bridge_path)" />
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_path)">
        <param name="use_sim_time" value="true" />
    </node>

    <!--include launch file of nav2_bringup-->
    <timer period="15">
        <include file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py"> 
            <arg name="params_file" value="$(var nav2_config_path)" />
            <arg name="use_sim_time" value="true" />
        </include>
    </timer>
    
    <!--include launch file of slam_toolbox-->
    <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py" >
        <arg name="slam_params_file" value="$(var slam_toolbox_config_path)" />
        <arg name="use_sim_time" value="true" />
    </include>

    <!--frontier explorer node-->
    <timer period= "10">
        <node pkg="my_car_control" exec="explorer" >
            <param name="use_sim_time" value="true" />
        </node>
    </timer>

    <!--include launch file of nav2_map_server-->
    <include file="$(find-pkg-share nav2_map_server)/launch/map_saver_server.launch.py" />
    
    <timer period="10" >
        <node pkg="my_car_detection" exec="detector" />
    </timer>

    <timer period="10" >
        <node pkg="my_car_control" exec="follower" />
    </timer>
</launch>

