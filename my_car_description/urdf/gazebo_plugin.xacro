<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!--plugins for the joints. 
    Because of 4 wheels, diff drive system has 2 left-joint tags and 2 right-joint tags-->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>base_front_left_wheel</left_joint>
            <right_joint>base_front_right_wheel</right_joint>

            <left_joint>base_rear_left_wheel</left_joint>
            <right_joint>base_rear_right_wheel</right_joint>
            <wheel_radius>${wheel_radius}</wheel_radius>

            <!--separation between a left wheel and a right wheel. Only 1 separation tag is needed-->
            <wheel_separation>${body_length - wheel_length}</wheel_separation>

            <topic>/cmd_vel</topic>
            <tf_topic>/tf</tf_topic>

            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
            <odom_topic>/odom</odom_topic>
        </plugin>
    </gazebo>

    <!--joint state publisher plugin, for non-fixed joints-->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>

            <joint_name>base_front_left_wheel</joint_name>
            <joint_name>base_front_right_wheel</joint_name>
            <joint_name>base_rear_left_wheel</joint_name>
            <joint_name>base_rear_right_wheel</joint_name>
        </plugin>
    </gazebo>

</robot>