<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">   
    <link name="base_footprint" />

    <link name="base_link" >
        <visual>
            <geometry> 
                <mesh filename="package://my_car_description/meshes/car.dae" scale="1.0 1.0 1.0" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <inertial>
            <mass value="${car_mass}" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="${car_mass*(body_width*body_width + body_height*body_height)/12}" ixy="0" ixz="0" 
                     iyy="${car_mass*(body_length*body_length + body_height*body_height)/12}" iyz="0" 
                     izz="${car_mass*(body_width*body_width + body_length*body_length)/12}" />
        </inertial>
        <collision>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height - wheel_radius}"/>
            </geometry>
            <origin xyz="0 0 ${wheel_radius/2}" rpy="0 0 0" />
        </collision>
    </link>

    <!--wheels-->
    <xacro:wheel prefix="front_left" />
    <xacro:wheel prefix="front_right" />
    <xacro:wheel prefix="rear_left" />
    <xacro:wheel prefix="rear_right" />

    <!--joints-->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius + body_height / 2}" rpy="0 0 0" />
    </joint>

    <joint name="base_front_left_wheel" type="continuous">
        <parent link="base_link" />
        <child link="front_left_wheel" />
        <axis xyz="0 1 0" />
        <origin xyz="${body_length/4} ${(body_width - wheel_length)/2} ${-body_height/2}" rpy="0 0 0" />
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <joint name="base_front_right_wheel" type="continuous">
        <parent link="base_link" />
        <child link="front_right_wheel" />
        <axis xyz="0 1 0" />
        <origin xyz="${body_length/4} ${(-body_width + wheel_length)/2} ${-body_height/2}" rpy="0 0 0" />
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <joint name="base_rear_left_wheel" type="continuous">
        <parent link="base_link" />
        <child link="rear_left_wheel" />
        <axis xyz="0 1 0" />
        <origin xyz="${-body_length/4} ${(body_width - wheel_length)/2} ${-body_height/2}" rpy="0 0 0" />
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <joint name="base_rear_right_wheel" type="continuous">
        <parent link="base_link" />
        <child link="rear_right_wheel" />
        <axis xyz="0 1 0" />
        <origin xyz="${-body_length/4} ${(-body_width + wheel_length)/2} ${-body_height/2}" rpy="0 0 0" />
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

</robot>